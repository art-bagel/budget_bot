{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "concepts",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "4173", "--directory", "ui-redesign-concepts"],
      "port": 4173
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "--port", "5173"],
      "port": 5173
    },
    {
      "name": "backend",
      "runtimeExecutable": "./venv/bin/uvicorn",
      "runtimeArgs": ["backend.app.main:app", "--reload", "--port", "8000"],
      "port": 8000
    }
  ]
}
