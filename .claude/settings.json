{
  "permissions": {
    "allow": [
      "Bash(npx tsc *)",
      "Bash(npx --no-install tsc *)",
      "Bash(npx biome check *)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(./venv/bin/ruff check *)",
      "Bash(docker compose config *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(curl -s http://localhost:8000/health)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post_edit_check.sh",
            "timeout": 90,
            "statusMessage": "Typecheck + lint"
          }
        ]
      }
    ]
  }
}
