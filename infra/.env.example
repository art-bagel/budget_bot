# development | production. In production the API refuses to start without
# TELEGRAM_BOT_TOKEN and CREDENTIALS_ENCRYPTION_KEY, and the dev auth fallback
# (X-Telegram-User-Id header) is always rejected.
APP_ENV=development

POSTGRES_USER=postgres
# Required — compose has no default on purpose. Pick a strong password.
POSTGRES_PASSWORD=

DB_DATABASE=budget_bot
DB_SCHEMA=budgeting

APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_ORIGINS=http://localhost:8080

TELEGRAM_BOT_TOKEN=
TELEGRAM_INIT_DATA_TTL_SECONDS=10800

# Fernet key for encrypting external credentials (Tinkoff token) at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=

# Срок жизни сессии клиента, 90 дней по умолчанию. Продлевается скользящим
# окном, пока пользователь заходит.
SESSION_TTL_SECONDS=7776000

# Код приглашения для регистрации по email. Пока пуст, регистрация вне
# Telegram выключена целиком — это намеренный fail closed, чтобы аккаунт
# себе не завёл любой, кто узнал адрес сервера. В production API не стартует
# с кодом короче 16 символов.
# Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
SIGNUP_INVITE_CODE=

DB_HOST=db
DB_PORT=5432

# Hourly PostgreSQL backups to MinIO (see docs/MINIO_BACKUPS.md).
MINIO_ENDPOINT=https://s3.mrbagel.ru
MINIO_BUCKET=budgetbackup
MINIO_PREFIX=budget-bot
MINIO_ACCESS_KEY=budgetbackup-user
MINIO_SECRET_KEY=
BACKUP_RETENTION=3
