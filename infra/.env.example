# development | production. In production the API refuses to start without
# TELEGRAM_BOT_TOKEN and CREDENTIALS_ENCRYPTION_KEY, and the dev auth fallback
# (X-Telegram-User-Id header) is always rejected.
APP_ENV=development

POSTGRES_USER=postgres
# Required — compose has no default on purpose. Pick a strong password.
POSTGRES_PASSWORD=

DB_DATABASE=budget_bot
DB_SCHEMA=budgeting

APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_ORIGINS=http://localhost:8080

TELEGRAM_BOT_TOKEN=
TELEGRAM_INIT_DATA_TTL_SECONDS=10800

# Fernet key for encrypting external credentials (Tinkoff token) at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=

DB_HOST=db
DB_PORT=5432
